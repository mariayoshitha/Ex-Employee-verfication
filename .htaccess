Options -Indexes
RewriteEngine On
RewriteBase /

# Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Block direct access to sensitive files (THE_REQUEST is the original HTTP
# request line — unchanged by internal mod_rewrite passes, so this blocks
# direct browser requests without blocking internal rewrites)
RewriteCond %{THE_REQUEST} \s/data\.json[\s?] [NC]
RewriteRule ^ - [F,L]

RewriteCond %{THE_REQUEST} \s/audit\.json[\s?] [NC]
RewriteRule ^ - [F,L]

RewriteCond %{THE_REQUEST} \s/admin\.php[\s?] [NC]
RewriteRule ^ - [F,L]

RewriteCond %{THE_REQUEST} \s/api\.php[\s?] [NC]
RewriteRule ^ - [F,L]

RewriteCond %{THE_REQUEST} \s/\.htaccess[\s?] [NC]
RewriteRule ^ - [F,L]

RewriteCond %{THE_REQUEST} \s/verify-techtiera-credentials\.php[\s?] [NC]
RewriteRule ^ - [F,L]

RewriteCond %{THE_REQUEST} \s/tt-config\.json[\s?] [NC]
RewriteRule ^ - [F,L]

RewriteCond %{THE_REQUEST} \s/tt-config\.json\.lock[\s?] [NC]
RewriteRule ^ - [F,L]

RewriteCond %{THE_REQUEST} \s/audit-\d{4}-\d{2}\.json[\s?] [NC]
RewriteRule ^ - [F,L]

RewriteCond %{THE_REQUEST} \s/sync\.php[\s?] [NC]
RewriteRule ^ - [F,L]

# Defence in depth: never serve data/backup/log/import files, whatever their name
RewriteCond %{THE_REQUEST} \s/[^\s?]*\.(json|log|lock|bak|xlsx|csv|zip|ini|[a-z-]*bak)[\s?] [NC]
RewriteRule ^ - [F,L]

# Let PHP see the Authorization header (some cPanel/FastCGI setups strip it)
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# TEMPORARY (PHP2Shell, CVE-2026-109618/109619, Oct 2026): PHP parses multipart/form-data before
# any app code or login check, and every known exploit trigger is a multipart request. Only the admin
# bulk-upload (CSV/XLSX) needs multipart. REMOVE this block once the host confirms PHP >= 8.5.12 / 8.4.27 /
# 8.3.36 / 8.2.35 (or a vendor backport) so bulk upload works again.
RewriteCond %{HTTP:Content-Type} multipart/form-data [NC]
RewriteRule ^ - [F,L]

# Clean URL routing
RewriteRule ^admin/?$   admin.php   [L]
RewriteRule ^api/sync/?$ sync.php   [L]
RewriteRule ^api/?$     api.php     [QSA,L]
RewriteRule ^manual/?$  manual.html [L]

# Security headers
<IfModule mod_headers.c>
  Header always set X-Frame-Options "DENY"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-XSS-Protection "1; mode=block"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; frame-ancestors 'none';"
</IfModule>
